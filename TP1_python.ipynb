    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "P0 = np.array([1, 2])\n",
    "P1 = np.array([5, 4])\n",
    "t = np.linspace(0, 1, 100)\n",
    "\n",
    "def L(t):\n",
    "    return (1 - t) * P0 + t * P1\n",
    "\n",
    "#Ejercicio 1A\n",
    "L0 = L(0)\n",
    "print(L0)\n",
    "L1 = L(1)\n",
    "print(L1)\n",
    "Lmed = L(0.5)\n",
    "print(Lmed)\n",
    "#Ejercicio 1B\n",
    "puntos = L(t[:, np.newaxis])\n",
    "x = puntos[:, 0]\n",
    "print(x)\n",
    "y = puntos[:, 1]\n",
    "print(y)\n",
    "\n",
    "#Ejercicio 1C\n",
    "plt.plot(x, y)\n",
    "plt.scatter(P0[0], P0[1])\n",
    "plt.scatter(P1[0], P1[1])\n",
    "plt.scatter(Lmed[0], Lmed[1])\n",
    "plt.grid(True)\n",
    "plt.axis(\"equal\")\n",
    "plt.show()\n",
    "\n",
